PDF := operator-algebra-modular-theory-and-quantum-gravity.pdf
JOBNAME := $(basename $(PDF))

TEX_SOURCES := \
	$(wildcard chapters/*.tex) \
	$(wildcard parts/*.tex) \
	$(wildcard appendices/*.tex) \
	$(wildcard frontmatter/*.tex) \
	preamble.tex \
	macros.tex \
	refs.bib

.PHONY: all pdf ch check clean

all: pdf

pdf: $(PDF)

# main.tex is generated by scripts/gen.py.
main.tex: scripts/gen.py scripts/chapters.tsv scripts/parts.tsv $(TEX_SOURCES)
	python3 scripts/gen.py

$(PDF): main.tex
	latexmk -pdf \
		-interaction=nonstopmode \
		-halt-on-error \
		-file-line-error \
		-jobname=$(JOBNAME) \
		main.tex

# Build a single chapter quickly: make ch N=10
# (cross-references to other chapters stay unresolved in this mode)
ch:
	@test -n "$(N)" || { echo "usage: make ch N=<chapter number>"; exit 1; }
	python3 scripts/chapter_only.py $(N)

# Build, then fail on unresolved references/citations (the same check CI runs).
check: $(PDF)
	scripts/check_log.sh $(JOBNAME).log $(PDF)

clean:
	if [ -f main.tex ]; then latexmk -C -jobname=$(JOBNAME) main.tex; fi
	rm -f _one.* $(JOBNAME).bbl $(JOBNAME).ind $(JOBNAME).idx $(JOBNAME).ilg $(JOBNAME).toc
